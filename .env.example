# Copy to .env and fill in. `.env` is git-ignored.

# --- C project to migrate -------------------------------------------------
# Bundled fixture (3 files) — start here.
C_SOURCE_DIR=./dummy_c_project
C_PROJECT_NAME=dummy_c_project
#
# For another project use forward slashes; C_PROJECT_NAME MUST equal the
# directory's base name, or `rustprint migrate` aborts.
# C_SOURCE_DIR=C:/Users/User/Work/my-c-project
# C_PROJECT_NAME=my-c-project

# --- LLM ------------------------------------------------------------------
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.openai.com/v1
MODEL=gpt-5.4

# Retry budget for HTTP 429. The OpenAI SDK default is 2, which is not enough
# for per-minute quota windows (Google AI Studio free tier answers ~26s).
LLM_MAX_RETRIES=8

# --- Pipeline cost controls (used by docker/write-config.sh) --------------
# Both refinement loops are ON by default in the app and drive most of the
# token spend. Keep them off for a first run.
REQUIREMENT_REFINEMENT=false
REQUIREMENT_ROUNDS=2
EXECUTION_REFINEMENT=false
EXECUTION_ROUNDS=2
TRANSLATE_TESTS=false

# --- Web tracker ----------------------------------------------------------
C2JAVA_WEB_PORT=5000
